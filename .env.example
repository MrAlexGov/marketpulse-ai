# LLM — любой OpenAI-совместимый API. По умолчанию OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=qwen/qwen3.8-27b:free
# OpenRouter: запасные модели, если основная недоступна или упёрлась в лимит бесплатного тарифа
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Локально через Ollama:  LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen3:8b

# Битрикс24: входящий вебхук вида https://<портал>.bitrix24.ru/rest/<user_id>/<код>/
# Пусто — create_bitrix24_task работает в режиме dry-run.
BITRIX24_WEBHOOK_URL=
BITRIX24_RESPONSIBLE_ID=1

CLICKHOUSE_MCP_PASSWORD=mcp_readonly
